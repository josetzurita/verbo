# Cloudflare static-asset headers. Copied to out/ by the build, applied by Workers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

# Content-hashed by Next (scripts, styles, fonts), so a new deploy always gets new URLs.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed file names, so a replaced image can show up to a day late; revalidated in the background.
/about/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/belief/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/case/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/close/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/cursor-trail/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
